<?xml version="1.0" encoding="UTF-8"?>
<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.wzkris</groupId>
        <artifactId>wzkris-payment</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>wzkris-payment-biz</artifactId>

    <description>支付网关运行层：渠道抽象、下单/回调/退款编排、持久化</description>

    <properties>
        <!-- 版本对齐 wzkris-common-weixin-sdk -->
        <weixin-java.version>4.8.5.B</weixin-java.version>
    </properties>

    <dependencies>
        <!-- SpringCloud Alibaba Nacos -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>

        <!-- SpringCloud Alibaba Nacos Config -->
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>

        <!-- Sentinel -->
        <dependency>
            <groupId>com.wzkris</groupId>
            <artifactId>wzkris-common-sentinel</artifactId>
        </dependency>

        <dependency>
            <groupId>com.wzkris</groupId>
            <artifactId>wzkris-common-web</artifactId>
        </dependency>

        <!-- 日志服务-->
        <dependency>
            <groupId>com.wzkris</groupId>
            <artifactId>wzkris-common-log</artifactId>
        </dependency>

        <dependency>
            <groupId>com.wzkris</groupId>
            <artifactId>wzkris-payment-api</artifactId>
            <version>${revision}</version>
        </dependency>

        <!-- 微信支付 -->
        <dependency>
            <groupId>com.github.binarywang</groupId>
            <artifactId>weixin-java-pay</artifactId>
            <version>${weixin-java.version}</version>
        </dependency>

        <!-- 支付宝开放平台 -->
        <dependency>
            <groupId>com.alipay.sdk</groupId>
            <artifactId>alipay-sdk-java</artifactId>
            <version>3.1.0</version>
        </dependency>

        <!-- wzkris Common Security-->
        <dependency>
            <groupId>com.wzkris</groupId>
            <artifactId>wzkris-common-security</artifactId>
        </dependency>

        <!-- wzkris Common Redis-->
        <dependency>
            <groupId>com.wzkris</groupId>
            <artifactId>wzkris-common-redis</artifactId>
        </dependency>

        <!-- wzkris Common Remote-->
        <dependency>
            <groupId>com.wzkris</groupId>
            <artifactId>wzkris-common-remote</artifactId>
        </dependency>

        <!-- springBoot test-->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

    </dependencies>

    <build>
        <finalName>${project.artifactId}</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
